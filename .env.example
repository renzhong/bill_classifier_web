# ===== Backend =====
BCW_ENV=dev                                # dev / test / prod
BCW_LOG_LEVEL=INFO

# DB
BCW_DB_HOST=mysql
BCW_DB_PORT=3306
BCW_DB_USER=bcw
BCW_DB_PASSWORD=bcw_dev_password
BCW_DB_NAME=bill_classifier_web

# JWT
BCW_JWT_SECRET=change-me-to-a-long-random-string
BCW_JWT_ALG=HS256
BCW_JWT_ACCESS_TTL_MIN=120
BCW_JWT_REFRESH_TTL_DAYS=14

# Fernet 加密 AI api_key（用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成）
BCW_FERNET_KEY=change-me-generate-via-fernet

# CORS / 前端访问源
BCW_CORS_ORIGINS=http://localhost:5173,http://localhost:8088

# 上传限制
BCW_UPLOAD_MAX_BYTES=10485760

# ===== MySQL container =====
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=bill_classifier_web
MYSQL_USER=bcw
MYSQL_PASSWORD=bcw_dev_password

# ===== Ports =====
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
MYSQL_HOST_PORT=3306
NGINX_TEST_HOST_PORT=8088
